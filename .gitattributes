# Line endings, declared once instead of left to each machine's git config.
#
# Why this file exists: `index-v2.html` is generated by `build.mjs` and tracked,
# because it is the artifact a visitor double-clicks. Without a policy, git
# normalises it on the way in and rewrites 897 KB of line endings into a commit
# that changed nothing, and every warning on every commit is about that file.
#
# Rule of thumb: source and prose are LF in the repository; the built museum and
# anything that is not text are left alone byte for byte.

# Source, checks and probes
*.js   text eol=lf
*.mjs  text eol=lf
*.css  text eol=lf
*.json text eol=lf
*.txt  text eol=lf

# Prose
*.md   text eol=lf

# This file itself, so that declaring the policy does not warn about itself
.gitattributes text eol=lf

# Hand-written pages are LF like everything else
*.html text eol=lf

# The built museum: opaque bytes. A line-ending change in here is a 897 KB diff
# that means nothing, and it is regenerated by `node build.mjs` anyway. This line
# comes last on purpose: in .gitattributes the last matching pattern wins.
index-v2.html -text

# Evidence and backups
*.png    binary
*.jpg    binary
*.jpeg   binary
*.webp   binary
*.gif    binary
*.bundle binary
*.zip    binary

# A scratch copy of a previous build, used to diff two builds byte for byte
scratch/prev.html -text
scratch/bundle.js -text
